<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dockCore="using:Dock.Model.Core"
        xmlns:layouts="using:Yohuke.DanmuPanel.Layouts">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Yohuke.DanmuPanel.Shared/Views/Styles/PanelResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Button:not(.dockChromeButton):not(.messageHeaderButton), ToggleButton.actionToggle">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="CornerRadius" Value="{StaticResource WorkbenchControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource WorkbenchButtonPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <StyleInclude Source="avares://Yohuke.DanmuPanel.Shared/Views/Styles/BaseControlStyles.axaml" />
    <StyleInclude Source="avares://Yohuke.DanmuPanel/Views/Styles/MainWindowStyles.axaml" />
    <StyleInclude Source="avares://Yohuke.DanmuPanel.Shared/Views/Styles/MessageStyles.axaml" />

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
    </Style>

    <Style Selector="Menu.workbenchMenu">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Menu.workbenchMenu > MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="Border.workbenchFrame">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WorkbenchPanelCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="dock|ToolChromeControl">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolChromeControl /template/ Grid#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    </Style>

    <Style Selector="dock|ToolChromeControl:active /template/ Grid#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    </Style>

    <Style Selector="dock|ToolChromeControl /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="dock|ToolChromeControl:active /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <Style Selector="dock|ToolChromeControl /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
        </Setter>
    </Style>

    <Style Selector="dock|ToolChromeControl:active /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <Style Selector="Button.dockChromeButton, Button.messageHeaderButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.dockChromeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.messageHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="Button.dockChromeButton:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.messageHeaderButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>

    <Style Selector="dock|ToolControl /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolControl">
        <Setter Property="HeaderTemplate">
            <DataTemplate x:DataType="dockCore:IDockable">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="dockTabTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                    <ContentControl Content="{Binding}" VerticalContentAlignment="Center">
                        <ContentControl.ContentTemplate>
                            <layouts:WorkbenchHeaderBadgeTemplate />
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="dock|ToolTabStrip">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolTabStrip /template/ Border#PART_BorderLeftFill, dock|ToolTabStrip /template/ Border#PART_BorderRightFill, dock|ToolTabStrip /template/ Border#PART_BorderFill">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolTabStripItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
    </Style>

    <Style Selector="dock|ToolTabStripItem:selected">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="dock|ToolTabStripItem">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="dock|ToolTabStripItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="dock|ToolTabStripItem:selected, dock|ToolTabStripItem:selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>

    <Style Selector="dock|ToolTabStripItem TextBlock.dockTabTitle">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
    </Style>

    <Style Selector="dock|ToolTabStripItem:selected TextBlock.dockTabTitle">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
</Styles>
