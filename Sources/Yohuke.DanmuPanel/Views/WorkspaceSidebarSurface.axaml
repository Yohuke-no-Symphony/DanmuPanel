<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="using:Yohuke.DanmuPanel.ViewModels.Workspace"
             x:Class="Yohuke.DanmuPanel.Views.WorkspaceSidebarSurface"
             x:DataType="items:WorkspacePanelViewModel"
             x:Name="Root">
    <Border x:Name="WorkspaceSurface" Classes="sidebar">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Loc Key=Panel.AddWorkspace}"
                          Command="{Binding AddWorkspaceCommand}">
                    <MenuItem.Icon>
                        <LucideIcon Kind="FolderPlus" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Loc Key=Workspace.Import}"
                          Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).ImportCommand}">
                    <MenuItem.Icon>
                        <LucideIcon Kind="Import" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <ScrollViewer Margin="14,10,14,12">
            <ItemsControl Classes="workspaceTree"
                          ItemsSource="{Binding Workspaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="items:WorkspaceTreeItemViewModel">
                        <StackPanel Spacing="4"
                                    Margin="0,0,0,8">
                            <Grid Classes="workspaceTreeRow">
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding}">
                                        <MenuItem Header="{Loc Key=Panel.AddRoom}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).AddRoomCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="Monitor" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Loc Key=Workspace.Settings}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).EditWorkspaceCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="Settings" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{Loc Key=Workspace.MoveUp}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).WorkspaceUpCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="SquareArrowUp" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Loc Key=Workspace.MoveDown}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).WorkspaceDownCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="SquareArrowDown" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{Loc Key=Workspace.Export}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).ExportCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="FileDown" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Loc Key=Workspace.Import}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).ImportCommand}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="Import" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{Loc Key=Panel.Delete}"
                                                  Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).DeleteWorkspaceCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <LucideIcon Kind="Trash2" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Button Classes="treeWorkspaceButton"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).SelectWorkspaceCommand}" CommandParameter="{Binding}"
                                        DoubleTapped="Workspace_OnDoubleTapped">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding State.Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AccountLabel}"
                                                       Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RoomCountText}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Rooms}"
                                          IsVisible="{Binding State.IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="items:RoomTreeItemViewModel">
                                        <Button Classes="treeRoomButton"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).SelectRoomCommand}" CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding}">
                                                    <MenuItem Header="{Loc Key=Workspace.MoveUp}"
                                                              Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).RoomUpCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <LucideIcon Kind="SquareArrowUp" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Loc Key=Workspace.MoveDown}"
                                                              Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).RoomDownCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <LucideIcon Kind="SquareArrowDown" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{Loc Key=Panel.Delete}"
                                                              Command="{Binding #Root.((items:WorkspacePanelViewModel)DataContext).DeleteRoomCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <LucideIcon Kind="Trash2" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <Border Classes="roomAvatarPlaceholder"
                                                        Background="{DynamicResource AppSidebarSelectedBrush}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <TextBlock Text="{Binding AvatarPlaceholderText}"
                                                                   IsVisible="{Binding HasNoAvatar}" />
                                                        <Image Source="{Binding AvatarImage}"
                                                               IsVisible="{Binding HasAvatar}"
                                                               Stretch="UniformToFill" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding State.Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding State.RoomId}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="3"
                                                        Classes="listenStatusLight"
                                                        Classes.listening="{Binding IsListening}"
                                                        Classes.idle="{Binding !IsListening}"
                                                        ToolTip.Tip="{Binding ConnectionStatus}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
