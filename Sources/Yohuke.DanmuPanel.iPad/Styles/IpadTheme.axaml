<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:Yohuke.DanmuPanel.I18n">
    <Styles.Resources>
        <x:Double x:Key="WorkbenchControlHeight">44</x:Double>
        <x:Double x:Key="AppFontSizeBody">14</x:Double>
        <x:Double x:Key="AppFontSizeCaption">12</x:Double>
        <x:Double x:Key="AppFontSizeTitle">16</x:Double>
    </Styles.Resources>
    <Style Selector="Button, TextBox, ComboBox, ComboBoxItem, ListBoxItem, MenuItem, NumericUpDown, ToggleSwitch, TabStripItem">
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinWidth" Value="44" />
    </Style>
    <Style Selector="Button.navButton">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.ipadIconButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ipadIconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>
    <Style Selector="Button.ipadIconButton.selected">
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>
    <Style Selector="Button.ipadIconButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>
    <Style Selector="Button.ipadIconButton LucideIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style Selector="Button.ipadListenToggle">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ipadListenToggle.idle">
        <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
    </Style>
    <Style Selector="Button.ipadListenToggle.listening">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
    </Style>
    <Style Selector="Border.ipadListenStatus">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ipadListenStatus.idle">
        <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" />
    </Style>
    <Style Selector="Border.ipadListenStatus.listening">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
    </Style>
    <Style Selector="Menu.ipadWorkbenchMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Menu.ipadWorkbenchMenu > MenuItem">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.ipadWorkbenchPanel">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WorkbenchPanelCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.ipadSidebar">
        <Setter Property="Background" Value="{DynamicResource AppSidebarBrush}" />
    </Style>
    <Style Selector="TextBlock.ipadPanelTitle">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ipadWorkspaceRow, Button.ipadRoomRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.ipadRoomRow">
        <Setter Property="Margin" Value="4,1,0,1" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Button.ipadWorkspaceRow.selected, Button.ipadRoomRow.selected">
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>
    <Style Selector="Button.ipadWorkspaceRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ipadRoomRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>
    <Style Selector="Border.ipadSetupBanner">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.ipadCard">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource WorkbenchPanelCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.helpText">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Button.messageHeaderButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabStrip.messageReadTabs TabStripItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="44" />
    </Style>
    <Style Selector="TabStrip.ipadCategoryTabs TabStripItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Thumb.messageColumnSplitter">
        <Setter Property="MinWidth" Value="16" />
    </Style>
    <Style Selector="GridSplitter.ipadReadingSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Border Name="PART_Grip" Width="4" Height="48" CornerRadius="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource AppMutedTextBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.ipadReadingSplitter:pointerover /template/ Border#PART_Grip, GridSplitter.ipadReadingSplitter:pressed /template/ Border#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource AppTextBrush}" />
    </Style>
</Styles>
