<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Yohuke.DanmuPanel.Views.Components"
        xmlns:viewModels="clr-namespace:Yohuke.DanmuPanel.ViewModels">
    <Style Selector="FlyoutPresenter.messageCopyPopup">
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Border.danmuFeedRow">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.danmuFeedButton">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBox.danmuFeedList Button.danmuFeedButton">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    </Style>

    <Style Selector="ListBox.danmuFeedList Button.danmuFeedButton:alternate">
        <Setter Property="Background" Value="{DynamicResource AppDanmuAlternateRowBrush}" />
    </Style>

    <Style Selector="Button.danmuFeedButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="ListBox.feedList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.feedList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,16,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBox.feedList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="Button.messageCardButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.messageCardButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="Button.messageCardButton:pinged">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="1" FillMode="None">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="25%" KeySpline="0.4,0,0.2,1">
                    <Setter Property="TranslateTransform.X" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="50%" KeySpline="0.4,0,0.2,1">
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="75%" KeySpline="0.4,0,0.2,1">
                    <Setter Property="TranslateTransform.X" Value="3" />
                </KeyFrame>
                <KeyFrame Cue="100%" KeySpline="0.4,0,0.2,1">
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.messageCard">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.messageUnreadDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource AppUnreadBrush}" />
    </Style>

    <Style Selector="TextBlock.messagePinBadge">
        <Setter Property="Width" Value="{DynamicResource MessagePinBadgeSize}" />
        <Setter Property="Height" Value="{DynamicResource MessagePinBadgeSize}" />
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizePinyin}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.scFeedPrice">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.eventSummaryLabel">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
    </Style>

    <Style Selector="TextBlock.eventSummaryValue">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
    </Style>

    <Style Selector="Button.feedUserNameButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector=":is(Control).messageUserAvatar">
        <Setter Property="Width" Value="{DynamicResource MessageUserAvatarSize}" />
        <Setter Property="Height" Value="{DynamicResource MessageUserAvatarSize}" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style Selector="Grid.compactDanmu :is(Control).messageUserAvatar">
        <Setter Property="Width" Value="{DynamicResource MessageUserAvatarCompactSize}" />
        <Setter Property="Height" Value="{DynamicResource MessageUserAvatarCompactSize}" />
    </Style>

    <Style Selector="TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource MessageUserNameBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.danmuFeedMeta, TextBlock.eventSummaryTime">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeMetadata}" />
        <Setter Property="Foreground" Value="{DynamicResource MessageTimeBrush}" />
    </Style>

    <Style Selector="Grid.danmuMedalSlot, Grid.eventSummaryMedalSlot">
        <Setter Property="Width" Value="{DynamicResource MessageMedalSlotWidth}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.danmuMedalBadge, Border.danmuMedalPlaceholder">
        <Setter Property="Background" Value="{DynamicResource MedalBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.danmuMedalPlaceholder">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Border.danmuMedalBadge">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,2" />
    </Style>

    <Style Selector="Button:guardMedal Border.danmuMedalBadge" x:DataType="viewModels:MessageItemViewModel">
        <Setter Property="Background" Value="{Binding MedalBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock.danmuMedalText.danmuMedalPlaceholder">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
    </Style>

    <Style Selector="Grid.danmuMedalLayout">
        <Setter Property="ColumnSpacing" Value="2" />
    </Style>

    <Style Selector="TextBlock.danmuMedalText">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeMetadata}" />
        <Setter Property="Foreground" Value="{DynamicResource MedalTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.danmuMedalLevel">
        <Setter Property="Width" Value="{DynamicResource MessageMedalLevelWidth}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.danmuFeedContent">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
        <Setter Property="LineSpacing" Value="1" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.originalText">
        <Setter Property="Foreground" Value="{DynamicResource MessageOriginalBrush}" />
    </Style>

    <Style Selector="TextBlock.translatedText">
        <Setter Property="Foreground" Value="{DynamicResource MessageTranslationBrush}" />
    </Style>

    <Style Selector="components|ShimmerTextBlock.translationPending">
        <Setter Property="Foreground" Value="{DynamicResource MessageTranslationBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="components|HoverMarqueeTextBlock.originalText">
        <Setter Property="Foreground" Value="{DynamicResource MessageOriginalBrush}" />
    </Style>

    <Style Selector="components|HoverMarqueeTextBlock.translatedText">
        <Setter Property="Foreground" Value="{DynamicResource MessageTranslationBrush}" />
    </Style>

    <Style Selector="Button:captain TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource GuardCaptainUserNameBrush}" />
    </Style>

    <Style Selector="Button:admiral TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource GuardAdmiralUserNameBrush}" />
    </Style>

    <Style Selector="Button:governor TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource GuardGovernorUserNameBrush}" />
    </Style>

    <Style Selector="Button:roomAdmin TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource RoomAdminUserNameBrush}" />
    </Style>

    <Style Selector="Button:specialAttention TextBlock.danmuFeedUser">
        <Setter Property="Foreground" Value="{DynamicResource SpecialAttentionUserNameBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button:specialAttention TextBlock.originalText">
        <Setter Property="Foreground" Value="{DynamicResource SpecialAttentionContentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button:specialAttention components|HoverMarqueeTextBlock.originalText">
        <Setter Property="Foreground" Value="{DynamicResource SpecialAttentionContentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="components|HoverMarqueeTextBlock.compactFeedContent">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="components|MessageBodyPanel">
        <Setter Property="HorizontalSpacing" Value="8" />
        <Setter Property="VerticalSpacing" Value="2" />
    </Style>

    <Style Selector="Grid.scFeedLayout">
        <Setter Property="RowSpacing" Value="5" />
    </Style>

    <Style Selector="Grid.danmuFeedLayout">
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="1" />
    </Style>

    <Style Selector="Thumb.messageColumnSplitter, Border.messageColumnSplitterSpace">
        <Setter Property="Width" Value="10" />
    </Style>

    <Style Selector="Thumb.messageColumnSplitter">
        <Setter Property="Background" Value="{DynamicResource AppSplitterBrush}" />
    </Style>

    <Style Selector="Thumb.messageColumnSplitter:pointerover, Thumb.messageColumnSplitter:pressed, Thumb.messageColumnSplitter:focus-visible">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <Style Selector="Grid.compactDanmu Thumb.messageColumnSplitter, Grid.compactDanmu Border.messageColumnSplitterSpace">
        <Setter Property="Width" Value="6" />
    </Style>

    <Style Selector="Grid.compactDanmu Button.danmuFeedButton">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Grid.compactDanmu ListBox.feedList ListBoxItem">
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style Selector="Grid.compactDanmu Button.messageCardButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <Style Selector="Grid.compactDanmu Border.messageCard">
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style Selector="Grid.compactDanmu Grid.scFeedLayout">
        <Setter Property="RowSpacing" Value="2" />
    </Style>

    <Style Selector="Grid.compactDanmu Grid.danmuFeedLayout">
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="RowSpacing" Value="0" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.danmuFeedMeta, Grid.compactDanmu TextBlock.eventSummaryTime">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.danmuFeedUser">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.scFeedPrice">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.eventSummaryLabel, Grid.compactDanmu TextBlock.eventSummaryValue">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.danmuFeedContent">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
        <Setter Property="LineSpacing" Value="0" />
    </Style>

    <Style Selector="Grid.compactDanmu components|ShimmerTextBlock.translationPending">
        <Setter Property="FontSize" Value="{DynamicResource MessageFontSizeCompact}" />
    </Style>

    <Style Selector="Grid.compactDanmu TextBlock.regularFeedContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Grid.compactDanmu components|MessageBodyPanel">
        <Setter Property="VerticalSpacing" Value="1" />
    </Style>

    <Style Selector="Grid.compactDanmu components|HoverMarqueeTextBlock.compactFeedContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Grid.compactDanmu.compactDanmuWrap Button.danmuFeedButton TextBlock.regularFeedContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Grid.compactDanmu.compactDanmuWrap Button.danmuFeedButton components|HoverMarqueeTextBlock.compactFeedContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Grid.compactDanmu.compactSuperChatWrap Button.scFeedButton TextBlock.regularFeedContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Grid.compactDanmu.compactSuperChatWrap Button.scFeedButton components|HoverMarqueeTextBlock.compactFeedContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.scFeedButton.guardPurchase">
    </Style>

    <Style Selector="Button.scFeedButton.guardPurchase Grid.scFeedLayout">
        <Setter Property="RowSpacing" Value="0" />
    </Style>

    <Style Selector="Button.scFeedButton.guardPurchase TextBlock.danmuFeedMeta">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.messageHeaderButton">
        <Setter Property="Width" Value="{DynamicResource MessageHeaderButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource MessageHeaderButtonSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource MessageHeaderButtonSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource MessageHeaderButtonSize}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="{StaticResource WorkbenchControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.messageHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="Button.messageHeaderButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>

    <Style Selector="TabStrip.messageReadTabs">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabStrip.messageReadTabs TabStripItem">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabStrip.messageReadTabs TabStripItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
    </Style>

    <Style Selector="TabStrip.messageReadTabs TabStripItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
    </Style>

    <Style Selector="Border.panelUnreadBadge">
        <Setter Property="Background" Value="{DynamicResource AppUnreadBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.panelUnreadBadge > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppUnreadTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
