<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="WorkbenchControlHeight">32</x:Double>
    <x:Double x:Key="MessageHeaderButtonSize">44</x:Double>
    <CornerRadius x:Key="WorkbenchPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WorkbenchControlCornerRadius">6</CornerRadius>
    <Thickness x:Key="WorkbenchButtonPadding">12,6</Thickness>
    <Thickness x:Key="WorkbenchPanelPadding">12</Thickness>
    <x:Double x:Key="MessageFontSizeBody">13</x:Double>
    <x:Double x:Key="MessageFontSizeCompact">12</x:Double>
    <x:Double x:Key="MessageFontSizeMetadata">11</x:Double>
    <x:Double x:Key="MessageFontSizePinyin">10</x:Double>
    <x:Double x:Key="MessageMedalSlotWidth">66</x:Double>
    <x:Double x:Key="MessageMedalLevelWidth">20</x:Double>
    <x:Double x:Key="MessagePinBadgeSize">14</x:Double>
    <x:Double x:Key="MessageUserAvatarSize">20</x:Double>
    <x:Double x:Key="MessageUserAvatarCompactSize">16</x:Double>
    <Thickness x:Key="MessageCardBorderThickness">2</Thickness>
    <FontFamily x:Key="ContentControlThemeFontFamily">PingFang SC, Microsoft YaHei UI, Noto Sans CJK SC, Noto Sans SC, sans-serif</FontFamily>
    <SolidColorBrush x:Key="AppErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AppUnreadBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AppUnreadTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B" />
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppTitleBarBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppDanmuAlternateRowBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE2EA" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#111827" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#627087" />
            <SolidColorBrush x:Key="MessageOriginalBrush" Color="#111827" />
            <SolidColorBrush x:Key="MessageTranslationBrush" Color="#111827" Opacity="0.85" />
            <SolidColorBrush x:Key="SpecialAttentionUserNameBrush" Color="#B45309" />
            <SolidColorBrush x:Key="SpecialAttentionContentBrush" Color="#B45309" />
            <SolidColorBrush x:Key="MessageUserNameBrush" Color="#111827" />
            <SolidColorBrush x:Key="GuardCaptainUserNameBrush" Color="#2563A6" />
            <SolidColorBrush x:Key="GuardAdmiralUserNameBrush" Color="#7C3EC3" />
            <SolidColorBrush x:Key="GuardGovernorUserNameBrush" Color="#8A570A" />
            <SolidColorBrush x:Key="RoomAdminUserNameBrush" Color="#166534" />
            <SolidColorBrush x:Key="MessagePinyinBrush" Color="#627087" />
            <SolidColorBrush x:Key="MessageTimeBrush" Color="#627087" Opacity="0.6" />
            <SolidColorBrush x:Key="MedalBackgroundBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="MedalTextBrush" Color="#627087" />
            <SolidColorBrush x:Key="GuardCaptainBrush" Color="#4F8FDD" />
            <SolidColorBrush x:Key="GuardAdmiralBrush" Color="#A46EE8" />
            <SolidColorBrush x:Key="GuardGovernorBrush" Color="#E9A23B" />
            <SolidColorBrush x:Key="PriorityMessageBorderBrush" Color="#5B9BD5" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSplitterBrush" Color="#DDE2EA" />
            <SolidColorBrush x:Key="AppOverlayBrush" Color="#99000000" />
            <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="AppSidebarHoverBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.06" />
            <SolidColorBrush x:Key="AppSettingsFooterBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppAvatarBrush" Color="#E6E0FF" />
            <SolidColorBrush x:Key="AppAvatarTextBrush" Color="#6D4AFF" />
            <SolidColorBrush x:Key="AppThemeCardSelectedBrush" Color="#7BB8F5" />
            <SolidColorBrush x:Key="AppPreviewLightBrush" Color="#F4F4F5" />
            <SolidColorBrush x:Key="AppPreviewDarkBrush" Color="#3A3A3D" />
            <SolidColorBrush x:Key="AppPreviewLineBrush" Color="#C9CDD2" />
            <x:Double x:Key="AppFontSizeBody">13</x:Double>
            <x:Double x:Key="AppFontSizeCaption">12</x:Double>
            <x:Double x:Key="AppFontSizeTitle">15</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12151C" />
            <SolidColorBrush x:Key="AppTitleBarBrush" Color="#12151C" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="#1C222D" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#1C222D" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#1C222D" />
            <SolidColorBrush x:Key="AppDanmuAlternateRowBrush" Color="#252D3A" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#303949" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#9AAAC2" />
            <SolidColorBrush x:Key="MessageOriginalBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="MessageTranslationBrush" Color="#F2F4F8" Opacity="0.85" />
            <SolidColorBrush x:Key="SpecialAttentionUserNameBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SpecialAttentionContentBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="MessageUserNameBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="GuardCaptainUserNameBrush" Color="#78B5FF" />
            <SolidColorBrush x:Key="GuardAdmiralUserNameBrush" Color="#C69BFF" />
            <SolidColorBrush x:Key="GuardGovernorUserNameBrush" Color="#F3BD67" />
            <SolidColorBrush x:Key="RoomAdminUserNameBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="MessagePinyinBrush" Color="#9AAAC2" />
            <SolidColorBrush x:Key="MessageTimeBrush" Color="#9AAAC2" Opacity="0.6" />
            <SolidColorBrush x:Key="MedalBackgroundBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="MedalTextBrush" Color="#9AAAC2" />
            <SolidColorBrush x:Key="GuardCaptainBrush" Color="#4F8FDD" />
            <SolidColorBrush x:Key="GuardAdmiralBrush" Color="#A46EE8" />
            <SolidColorBrush x:Key="GuardGovernorBrush" Color="#E9A23B" />
            <SolidColorBrush x:Key="PriorityMessageBorderBrush" Color="#5B9BD5" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSplitterBrush" Color="#303949" />
            <SolidColorBrush x:Key="AppOverlayBrush" Color="#AA000000" />
            <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="AppSidebarHoverBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.06" />
            <SolidColorBrush x:Key="AppSettingsFooterBrush" Color="#12151C" />
            <SolidColorBrush x:Key="AppAvatarBrush" Color="#3E315D" />
            <SolidColorBrush x:Key="AppAvatarTextBrush" Color="#B895FF" />
            <SolidColorBrush x:Key="AppThemeCardSelectedBrush" Color="#7BB8F5" />
            <SolidColorBrush x:Key="AppPreviewLightBrush" Color="#F4F4F5" />
            <SolidColorBrush x:Key="AppPreviewDarkBrush" Color="#5B5B5E" />
            <SolidColorBrush x:Key="AppPreviewLineBrush" Color="#B9BDC4" />
            <x:Double x:Key="AppFontSizeBody">13</x:Double>
            <x:Double x:Key="AppFontSizeCaption">12</x:Double>
            <x:Double x:Key="AppFontSizeTitle">15</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
