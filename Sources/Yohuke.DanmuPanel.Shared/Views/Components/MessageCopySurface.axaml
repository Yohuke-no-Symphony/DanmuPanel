<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuPanel.Views.Components.MessageCopySurface"
             xmlns:vm="using:Yohuke.DanmuPanel.ViewModels" x:DataType="vm:MessageCopyViewModel"
             Width="420">
    <UserControl.Styles>
        <Style Selector="TabControl TabItem">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0,4,12,4" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <TabControl x:Name="CopySourceTabs" SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}" Padding="0">
            <TabItem Header="{Loc Key=Panel.CopyOriginal}">
                <TextBox x:Name="CopyOriginalText" Text="{Binding Original}" IsReadOnly="True"
                         ClearSelectionOnLostFocus="False"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </TabItem>
            <TabItem x:Name="CopyTranslationTab" IsVisible="{Binding HasTranslation}" Header="{Loc Key=Panel.CopyTranslation}">
                <TextBox x:Name="CopyTranslationText" Text="{Binding Translation}" IsReadOnly="True"
                         ClearSelectionOnLostFocus="False"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button x:Name="CopySelectedTextButton" IsEnabled="{Binding HasSelection}" Command="{Binding CopySelectionCommand}" Classes="primaryButton"
                    AutomationProperties.Name="{Loc Key=Panel.CopySelection}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="CopyCheck" Size="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Loc Key=Panel.CopySelection}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyAllTextButton" Command="{Binding CopyAllCommand}" AutomationProperties.Name="{Loc Key=Panel.CopyAll}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="Copy" Size="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Loc Key=Panel.CopyAll}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseCopyPopupButton" Command="{Binding CloseCommand}" AutomationProperties.Name="{Loc Key=Panel.CopyClose}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="X" Size="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Loc Key=Panel.CopyClose}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
