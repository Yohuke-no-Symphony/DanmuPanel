<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yohuke.DanmuPanel.ViewModels"
        xmlns:components="using:Yohuke.DanmuPanel.Views.Components"
        x:Class="Yohuke.DanmuPanel.Views.Components.MessageEventSummarySurface"
        x:DataType="vm:MessageItemViewModel" Classes="messageEventSummary">
    <Grid>
        <components:MessageFeedColumnLayout x:Name="SummaryColumns" Kind="Danmu">
            <Grid Classes="eventSummaryMedalSlot" IsVisible="{Binding ShowFanMedals}" />
            <components:MessageIdentitySurface x:Name="SummaryIdentity" Grid.Column="0" Grid.ColumnSpan="2" />
            <Grid x:Name="SummaryDetail" Grid.Column="3">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left"
                          IsVisible="{Binding HasSummaryHeader}">
                        <TextBlock Classes="eventSummaryLabel" Text="{Binding SummaryLabel}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding SummaryLabel}" />
                        <TextBlock Grid.Column="1" Classes="eventSummaryValue" Text="{Binding SummaryValue}" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip.Tip="{Binding SummaryValue}" />
                    </Grid>
                    <components:MessageBodyPanel x:Name="SummaryBody" IsVisible="{Binding HasSummaryBody}" />
                </StackPanel>
            </Grid>
        </components:MessageFeedColumnLayout>
        <Border x:Name="SummaryFrame" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                CornerRadius="6" IsHitTestVisible="False" />
    </Grid>
</Border>
